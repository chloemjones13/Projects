# Set the key for whichever provider you want to use.
# You only need the key that matches your chosen model.

# Anthropic  (default model: claude-sonnet-4-20250514)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI  (model: gpt-4o, gpt-4-turbo, etc.)
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini  (model: gemini/gemini-1.5-pro)
# GEMINI_API_KEY=your_gemini_api_key_here

# Mistral  (model: mistral/mistral-large-latest)
# MISTRAL_API_KEY=your_mistral_api_key_here

# Cohere  (model: cohere/command-r-plus)
# COHERE_API_KEY=your_cohere_api_key_here

# Ollama runs locally — no key needed  (model: ollama/llama3)

# Optionally pin a default model so you don't need --model every time
# LLM_MODEL=gpt-4o
